# Copy to .env and adjust. Never commit .env (it may hold API keys).

APP_ENV=development
LOG_LEVEL=INFO

# Local run (uvicorn on the host). docker compose overrides this for the api container.
DATABASE_URL=postgresql+asyncpg://taboo:taboo@localhost:5432/taboo

# --- Generation (any model pulled into Ollama: `ollama pull gemma4:12b`) ------------------
# Measured on an M4 Pro / 24 GB with the benchmark runner: gemma4:12b ~6 s per card and
# ~20 s for 5 cards, clean Turkish. qwen3.5:9b is slightly faster but made spelling errors;
# qwen3.5:27b is ~4-5x slower and does not fit in GPU memory next to the embedding model.
DEFAULT_GENERATION_PROVIDER=ollama
DEFAULT_GENERATION_MODEL=gemma4:12b
# Optional second local model used as fallback by the router (leave empty to skip).
FALLBACK_GENERATION_PROVIDER=ollama
FALLBACK_GENERATION_MODEL=

# --- Embeddings (multilingual; changing it requires `python -m app.cli rag-reindex`) ------
DEFAULT_EMBEDDING_PROVIDER=ollama
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_VERSION=v1

# --- Ollama ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Used by docker compose for the api container (Ollama running on the host machine).
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=15m
# Context window per request. 4096 is enough for batches of 10 cards; larger values need
# more (GPU) memory.
OLLAMA_NUM_CTX=4096
# How long the embedding model stays loaded. Use 0 on machines where the generation model
# barely fits into memory (e.g. a 27B model on 24 GB unified memory).
OLLAMA_EMBED_KEEP_ALIVE=5m

# --- Cloud providers (optional; provider is disabled when its key is empty) --------------
# CLOUD_A_API_KEY=

# --- Cards -------------------------------------------------------------------------------
SUPPORTED_LANGUAGES=tr,en,de,fr,es,ar
CARD_BATCH_SIZE=10
MAX_CARDS_PER_REQUEST=30
CARD_PROMPT_VERSION=v3
ALLOW_PARTIAL_RESULTS=true

# --- Retry limits ------------------------------------------------------------------------
MAX_PARSE_RETRIES=1
MAX_REPAIR_ATTEMPTS=2
MAX_GENERATION_ROUNDS=4
DEFAULT_MAX_PROVIDER_ATTEMPTS=3

# --- RAG -----------------------------------------------------------------------------------
RAG_ENABLED=true
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.3
RAG_FAIL_OPEN=true
EMBEDDING_MAX_RETRIES=1

# --- Admin API (/admin/v1/*). Empty = admin API disabled. Use a long random value. ------
ADMIN_API_TOKEN=

# CORS for web builds of the Flutter app (comma separated). Mobile apps do not need it.
CORS_ALLOW_ORIGINS=
